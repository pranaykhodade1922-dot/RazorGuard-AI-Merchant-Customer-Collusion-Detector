# RazorGuard AI Frontend Environment Variables
# Copy this file to .env.local and populate with your Firebase Web App credentials:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app -> Firebase SDK configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Custom backend API proxy target (defaults to http://127.0.0.1:8000)
# VITE_API_TARGET=http://127.0.0.1:8000
